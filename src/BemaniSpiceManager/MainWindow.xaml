<Window x:Class="BemaniSpiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bemani Spice Manager" Height="720" Width="1100" MinHeight="480" MinWidth="760"
        AllowDrop="True" Background="#FAFAFA"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid>
        <DockPanel>
            <!-- import bar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="12,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Choose archive…" Padding="10,3" Margin="6,0,0,0" Click="OnChooseArchive"/>
                        <Button Content="Add extracted folder…" Padding="10,3" Margin="6,0,0,0" Click="OnAddFolder"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="DimGray"
                               Text="Drop a game archive (.rar / .7z / .zip) anywhere on this window to add it to your library."/>
                </DockPanel>
            </Border>

            <!-- status / progress -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="12,6">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="10,2" Visibility="Collapsed" Click="OnCancel"/>
                    <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="14" Margin="10,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready."/>
                </DockPanel>
            </Border>

            <TabControl x:Name="Tabs" Margin="8" Padding="0">
                <TabItem Header="  Games  ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="GameList" BorderThickness="0,0,1,0" BorderBrush="#DDD" SelectionChanged="OnGameSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,5">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyHint" Grid.Column="1" Margin="20" TextWrapping="Wrap" Foreground="Gray" FontSize="14"
                                   Text="No game selected. Drop an archive on this window, or use the buttons at the top."/>
                        <ContentControl x:Name="GamePageHost" Grid.Column="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="  Servers  ">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ServerList" DisplayMemberPath="Name" BorderThickness="0,0,1,0" BorderBrush="#DDD" SelectionChanged="OnServerSelected"/>
                        <ContentControl x:Name="ServerPageHost" Grid.Column="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="  spice2x  ">
                    <ContentControl x:Name="SpicePageHost"/>
                </TabItem>
                <TabItem Header="  Settings  ">
                    <ContentControl x:Name="SettingsPageHost"/>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- shown while dragging an archive over the window -->
        <Border x:Name="DropOverlay" Background="#CC1E6FD9" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Drop to add this game" Foreground="White" FontSize="28" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
